# Copy to deploy/.env and replace both passwords. Do not commit .env.
HTTP_PORT=8088
ADMIN_USERNAME=admin
ADMIN_PASSWORD=replace-with-a-strong-admin-password
DATABASE_PASSWORD=replace-with-a-strong-database-password
COOKIE_SECURE=false
AI_MODE=local
AI_BASE_URL=https://api.openai.com
AI_MODEL=gpt-4o-mini
AI_API_KEY=
VIDEO_API_ENABLED=false
VIDEO_API_BASE_URL=https://your-openai-compatible-provider.example/v1
VIDEO_API_KEY=
VIDEO_API_MODEL=seedance-2.5-m2
VIDEO_API_SIZE=720x1280

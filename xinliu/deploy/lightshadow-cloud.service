[Unit]
Description=Lightshadow Cloud single administrator workbench
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=%h/apps/lightshadow-cloud/current
EnvironmentFile=%h/apps/lightshadow-cloud/shared/runtime.env
EnvironmentFile=%h/apps/lightshadow-cloud/shared/auth.env
EnvironmentFile=%h/apps/lightshadow-cloud/shared/database.env
ExecStart=%h/apps/lightshadow-cloud/runtime/node/bin/node work/production-server.cjs
Restart=on-failure
RestartSec=5
TimeoutStopSec=30
KillMode=mixed
UMask=0077
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=default.target

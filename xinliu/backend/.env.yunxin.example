# Copy to .env.yunxin.local, which is ignored by Git and Docker.
YUNXIN_TEXT_KEY=
YUNXIN_VIDEO_KEY=
YUNXIN_TEXT_BASE_URL=https://ai.yunxinapi.com/hub
YUNXIN_TEXT_MODEL=gemini-3.8-flash
YUNXIN_VIDEO_BASE_URL=https://ai.yunxinapi.com/hub/volcengine
YUNXIN_VIDEO_MODEL=doubao-seedance-2-0
# Business credit estimates, NOT supplier settlement prices. Blank blocks submission.
YUNXIN_TEXT_ESTIMATE_CREDITS=
YUNXIN_VISION_ESTIMATE_CREDITS=
YUNXIN_VIDEO_CREDITS_PER_SECOND=
YUNXIN_VIDEO_REFERENCE_CREDITS_PER_SECOND=
YUNXIN_VIDEO_AUDIO_CREDITS_PER_SECOND=
YUNXIN_VIDEO_RESULT_ORIGINS=
YUNXIN_VIDEO_ANALYSIS_INLINE=false

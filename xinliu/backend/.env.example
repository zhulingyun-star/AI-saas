XINLIU_HOST=127.0.0.1
XINLIU_PORT=8767
XINLIU_DATA_DIR=./backend/data
XINLIU_PROVIDER_CONFIG=./backend/provider.local.json
# Keep supplier keys outside browser storage. Set environment variables in your launch terminal.
XINLIU_VIDEO_KEY=
XINLIU_VISION_KEY=
XINLIU_TEXT_KEY=

# Default video adapter: SilvaMux / Seedance 2.0, 4 seconds / 480p / silent.
SILVAMUX_API_KEY=
# Fill with a verified operator estimate in local credits per output second.
# Empty means PRICE_UNKNOWN and blocks chargeable submission. Not the supplier settlement.
XINLIU_VIDEO_CREDITS_PER_SECOND=
# Comma-separated exact HTTPS origins returned by the authorized supplier.
XINLIU_VIDEO_RESULT_ORIGINS=

# Select providers independently: silvamux or yunxin. Defaults remain silvamux.
# The local machine may select yunxin in the ignored .env.local.
XINLIU_VIDEO_PROVIDER=silvamux
XINLIU_TEXT_PROVIDER=silvamux
XINLIU_VISION_PROVIDER=silvamux
# Yunxin credentials belong ONLY in backend/.env.yunxin.local (Git/Docker ignored).
# Use .env.yunxin.example as a blank template. Never copy source application.yml.

# Local H2 database; keep real passwords in ignored env files.
XINLIU_H2_PASSWORD=
# Optional local executable/JAR paths (defaults: java and pinned Maven/runtime H2 cache).
# XINLIU_JAVA=/absolute/path/to/java
# XINLIU_H2_JAR=/absolute/path/to/h2-2.3.232.jar

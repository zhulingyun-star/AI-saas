{
  "openapi": "3.1.0",
  "info": { "title": "心流本地出片联调 API", "version": "1.0.0", "description": "回环地址单操作者联调，不是生产多租户登录。创建任务和报价不生成；submit需明确费用授权。视频供应商采用可配置的xinliu-bridge请求/响应契约，不能把示例路径当成Seedance官方路径。" },
  "servers": [{ "url": "http://127.0.0.1:8767" }],
  "paths": {
    "/api/health": { "get": { "summary": "服务健康，无模型请求", "responses": { "200": { "description": "本地服务与配置状态" } } } },
    "/api/session": { "post": { "summary": "建立本地操作会话，需X-Xinliu-Local:1", "parameters": [{ "name": "X-Xinliu-Local", "in": "header", "required": true, "schema": { "const": "1" } }], "responses": { "200": { "description": "HttpOnly会话Cookie和CSRF标识；不是团队身份" }, "403": { "description": "缺少标识或跨站访问" } } } },
    "/api/config": { "get": { "summary": "非敏感供应商配置摘要", "security": [{ "localSession": [] }], "responses": { "200": { "description": "模型、能力、规格、报价是否已配置；不返回密钥" } } } },
    "/api/openapi": { "get": { "summary": "本接口规范", "responses": { "200": { "description": "OpenAPI 3.1 JSON" } } } },
    "/api/strategies": { "get": { "summary": "品类/拍法/功能策略目录", "security": [{ "localSession": [] }], "responses": { "200": { "description": "策略与必需素材" } } } },
    "/api/prompts/compile": { "post": { "summary": "本地编译三种独立提示词，不调用模型", "security": [{ "localSession": [], "csrf": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "$ref": "#/components/schemas/Plan" } } } }, "responses": { "200": { "description": "videoPrompt、visionPrompt、directorPrompt、negativePrompt与strategyId/version" }, "422": { "description": "策略或方案无效" } } } },
    "/api/assets": { "post": { "summary": "按客户保存文件或公网URL；本地文件最大16MB", "security": [{ "localSession": [], "csrf": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["clientId", "name", "type"], "properties": { "clientId": { "type": "string" }, "name": { "type": "string" }, "type": { "enum": ["image/jpeg", "image/png", "image/webp", "video/mp4", "video/webm", "audio/mpeg", "audio/wav", "audio/webm"] }, "base64": { "type": ["string", "null"] }, "url": { "type": ["string", "null"], "description": "授权公网HTTPS，不能使用本机localhost地址给外部模型" } } } } } }, "responses": { "201": { "description": "asset{id,name,type,sha256}" }, "200": { "description": "相同客户文件复用" }, "422": { "description": "格式、素材或URL无效" } } } },
    "/api/tasks": {
      "get": { "summary": "当前客户最近100条后端任务", "security": [{ "localSession": [] }], "parameters": [{ "$ref": "#/components/parameters/clientQuery" }], "responses": { "200": { "description": "任务列表，区别于浏览器演示产单" } } },
      "post": { "summary": "保存任务输入快照，幂等，不调用供应商", "security": [{ "localSession": [], "csrf": [] }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["clientId", "workId", "campaignId", "kind", "input", "assets", "idempotencyKey"], "properties": { "clientId": { "type": "string" }, "workId": { "type": "string" }, "campaignId": { "type": "string" }, "kind": { "enum": ["video", "vision", "text"] }, "input": { "$ref": "#/components/schemas/Plan" }, "assets": { "type": "array", "items": { "type": "object", "required": ["assetId", "role"], "properties": { "assetId": { "type": "string" }, "role": { "enum": ["product_image", "character_image", "garment_image", "reference_video", "motion_video", "voice_audio"] } } } }, "idempotencyKey": { "type": "string", "description": "同键同输入复用，不同输入409" } } } } } }, "responses": { "201": { "description": "draft任务" }, "200": { "description": "已有幂等任务" }, "409": { "description": "幂等键输入冲突" }, "422": { "description": "上下文、时间码、事实确认或素材职责缺失" } } }
    },
    "/api/tasks/{id}": { "get": { "summary": "读取持久化任务", "security": [{ "localSession": [] }], "parameters": [{ "$ref": "#/components/parameters/taskId" }, { "$ref": "#/components/parameters/clientQuery" }], "responses": { "200": { "description": "任务状态与对应Prompt" }, "404": { "description": "客户范围内不存在" } } } },
    "/api/tasks/{id}/quote": { "post": { "summary": "验证能力、输入与配置估价，不调用供应商", "security": [{ "localSession": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/taskId" }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["clientId"], "properties": { "clientId": { "type": "string" } } } } } }, "responses": { "200": { "description": "五分钟有效报价：id、credits、inputHash、providerHash" }, "409": { "description": "供应商未配置或报价未知" }, "422": { "description": "能力、画幅、时长或公网素材URL不支持" } } } },
    "/api/tasks/{id}/submit": { "post": { "summary": "明确确认后调用供应商，可能收费，不自动重试", "security": [{ "localSession": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/taskId" }], "requestBody": { "required": true, "content": { "application/json": { "schema": { "type": "object", "required": ["clientId", "quoteId", "authorized", "acceptedCredits", "budgetLimit"], "properties": { "clientId": { "type": "string" }, "quoteId": { "type": "string" }, "authorized": { "const": true }, "acceptedCredits": { "type": "number", "minimum": 0 }, "budgetLimit": { "type": "number", "minimum": 0 } } } } } }, "responses": { "200": { "description": "任务结果或unknown；已提交重复请求不再次调用" }, "409": { "description": "授权/报价/预算/并发条件不满足" } } } },
    "/api/tasks/{id}/refresh": { "post": { "summary": "用固定供应商与上游编号查单；不重新生成", "security": [{ "localSession": [], "csrf": [] }], "parameters": [{ "$ref": "#/components/parameters/taskId" }], "requestBody": { "content": { "application/json": { "schema": { "type": "object", "required": ["clientId"], "properties": { "clientId": { "type": "string" } } } } } }, "responses": { "200": { "description": "状态更新，成功结果安全转存；失败获取可继续查单" }, "409": { "description": "没有上游编号，需人工核对" }, "429": { "description": "查询间隔不足2秒" } } } },
    "/api/tasks/{id}/result": { "get": { "summary": "读取已转存MP4/WebM，支持Range", "security": [{ "localSession": [] }], "parameters": [{ "$ref": "#/components/parameters/taskId" }, { "$ref": "#/components/parameters/clientQuery" }], "responses": { "200": { "description": "video/mp4或video/webm" }, "206": { "description": "分段视频读取" }, "409": { "description": "结果未就绪" } } } }
  },
  "components": {
    "securitySchemes": { "localSession": { "type": "apiKey", "in": "cookie", "name": "xinliu_session" }, "csrf": { "type": "apiKey", "in": "header", "name": "X-Xinliu-CSRF" } },
    "parameters": { "taskId": { "name": "id", "in": "path", "required": true, "schema": { "type": "string" } }, "clientQuery": { "name": "clientId", "in": "query", "required": true, "schema": { "type": "string" } } },
    "schemas": {
      "Plan": { "type": "object", "required": ["config", "shots"], "properties": { "config": { "type": "object", "required": ["category", "format", "duration"], "properties": { "category": { "enum": ["服饰鞋包", "美妆个护", "食品饮料", "家居百货", "3C数码", "宠物用品", "信息流漫剧"] }, "format": { "type": "string" }, "generationCapability": { "enum": ["commerce", "reference", "motion", "scene", "dialogue", "drama"] }, "duration": { "type": "number", "exclusiveMinimum": 0, "maximum": 120 }, "factsConfirmed": { "type": "boolean" }, "outputSpec": { "type": "object", "properties": { "aspect": { "type": "string" }, "resolution": { "type": "string" } } } } }, "shots": { "type": "array", "minItems": 1, "maxItems": 100, "items": { "type": "object", "required": ["start", "end", "visual", "speech"], "properties": { "start": { "type": "number", "minimum": 0 }, "end": { "type": "number" }, "role": { "type": "string" }, "visual": { "type": "string" }, "speech": { "type": "string" } } } }, "drama": { "type": ["object", "null"] } } }
    }
  }
}
